{
  "description": "Напоминание про standards-audit и обновление описаний скиллов после правки стандартов или скиллов",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/audit-reminder.sh\""
          }
        ]
      }
    ]
  }
}
